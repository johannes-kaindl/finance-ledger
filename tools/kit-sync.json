{
  "sources": {
    "obsidian-kit": {
      "ref": "0.95.0"
    },
    "code-kit": {
      "ref": "0.75.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "callout",
        "frontmatter",
        "frontmatter-patch"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "./"
        ],
        [
          "../pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "i18n",
        "local-stamp",
        "markdown-table",
        "marker-zone",
        "rotation",
        "sha256",
        "split-list",
        "rel-path"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": [
        "clipboard"
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "window-timers"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "confirm",
        "hub",
        "settings_walker",
        "folder-suggest",
        "help-setting",
        "prompt-text",
        "setting-body-host"
      ]
    }
  ]
}
